{
  "name": "pptx-maker-composer",
  "description": "Slide composer for the presentation engine. Writes slide JSON, builds the .pptx, measures it and polishes autonomously. Runs as a sub-agent with no user interaction.",
  "mcpServers": {
    "sdpm": {
      "command": "{UV_BIN}",
      "args": ["run", "--frozen", "--directory", "{APP_DATA}/vendor/sdpm/mcp-local", "python", "server_acp.py"],
      "env": { "PYTHONPATH": "", "PATH": "{HOST_PATH}{PATH_SEP}{APP_DATA}/vendor/preview-tools/bin" },
      "timeout": 120000
    }
  },
  "prompt": "file://{APP_DATA}/vendor/sdpm/mcp-local/acp-agent-prompts/composer.md",
  "resources": [
    "file://{APP_DATA}/vendor/sdpm/skill/references/workflows/create-new-2-compose.md",
    "file://{APP_DATA}/vendor/sdpm/skill/references/workflows/create-new-3-review.md",
    "file://{APP_DATA}/vendor/sdpm/skill/references/workflows/slide-json-spec.md",
    "file://{APP_DATA}/vendor/sdpm/skill/references/guides/grid.md"
  ],
  "tools": [
    "@sdpm/analyze_template", "@sdpm/apply_style", "@sdpm/code_to_slide",
    "@sdpm/generate_pptx", "@sdpm/grid", "@sdpm/import_attachment",
    "@sdpm/init_presentation", "@sdpm/list_asset_sources", "@sdpm/list_guides",
    "@sdpm/list_styles", "@sdpm/list_templates", "@sdpm/list_workflows",
    "@sdpm/measure_slides", "@sdpm/pptx_to_json", "@sdpm/read_examples",
    "@sdpm/read_guides", "@sdpm/read_workflows", "@sdpm/run_python",
    "@sdpm/search_assets", "read", "glob", "grep"
  ],
  "model": "auto"
}
