{
  "name": "pptx-maker-style",
  "description": "Style creator. Builds a reusable presentation style guide (an HTML document) through conversation.",
  "mcpServers": {
    "sdpm": {
      "command": "{UV_BIN}",
      "args": ["run", "--directory", "{APP_DATA}/vendor/sdpm/mcp-local", "python", "server_acp.py"],
      "env": { "PYTHONPATH": "", "PATH": "{HOST_PATH}{PATH_SEP}{APP_DATA}/vendor/preview-tools/bin" },
      "timeout": 120000
    }
  },
  "prompt": "file://{APP_DATA}/vendor/sdpm/mcp-local/acp-agent-prompts/style-creator.md",
  "resources": [
    "file://{APP_DATA}/vendor/sdpm/skill/references/workflows/create-style.md",
    "file://{APP_ROOT}/prompts/spec-studio.md"
  ],
  "tools": [
    "@sdpm/run_style_python", "@sdpm/list_styles", "@sdpm/analyze_template",
    "read", "glob", "grep", "web_fetch", "web_search"
  ],
  "welcomeMessage": "What style would you like to create?",
  "model": "auto"
}
